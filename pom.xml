<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.tamacat</groupId>
  <artifactId>dependency-auto-update-tool</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Dependency Auto-Update Tool</name>
  <description>
    Standalone, on-demand CLI tool for a single-module Maven project: it
    detects candidate dependency updates, judges compatibility via a real
    `mvn clean verify` build/test run, and applies validated-safe updates to
    pom.xml with a configurable commit/push mode. General-purpose -- which
    branches it may operate on and their expected JDK are declared in
    config/tool.properties, not hardcoded. Originally built for, and shipped
    pre-configured for, its reference deployment: tamacat-httpd
    (https://github.com/tamacat/tamacat-httpd).
  </description>
  <url>https://github.com/tamacat/dependency-auto-update-tool</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <!--
          Bare defaults only (no configuration block); matches this
          repository's own established Surefire convention (team.md).
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.tamacat.depupdate.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
