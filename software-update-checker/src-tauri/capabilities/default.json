{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウに許可する操作。ファイル選択ダイアログ、osv.dev・endoflife.date・scorecard.dev・CISA KEV のページをブラウザで開くこと、ログとナレッジのフォルダを開くことだけを許可する。ファイルの保存先はバックエンドのダイアログで選ばせる。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://osv.dev/*"
        },
        {
          "url": "https://endoflife.date/*"
        },
        {
          "url": "https://scorecard.dev/viewer/*"
        },
        {
          "url": "https://www.cisa.gov/known-exploited-vulnerabilities-catalog*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPLOG"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$APPCONFIG"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    }
  ]
}
